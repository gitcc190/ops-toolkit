# ============================================================
# backup.env.example —— MySQL 备份配置模板
# 用法：
#   cp conf/backup.env.example conf/backup.env
#   chmod 600 conf/backup.env        # 必须 600，脚本会检查
#   然后编辑 conf/backup.env 填真实值
# 注意：backup.env 已被 .gitignore 排除，不会被提交
# ============================================================

# 数据库连接
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=backup_user
DB_PASS=change_me

# 要备份的库；ALL 表示所有库
DB_NAME=ops_demo

# 备份文件存放目录（建议放在独立数据盘）
BACKUP_DIR=/var/backups/mysql

# 保留天数
KEEP_DAYS=7
